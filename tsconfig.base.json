{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@poe2/pob-bridge": ["packages/pob-bridge/src/index.ts"],
      "@poe2/pob-bridge/*": ["packages/pob-bridge/src/*"]
    }
  }
}
